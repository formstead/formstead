{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#7.1.3",
	"phpVersion": "8.3",
	"mariadbVersion": "10.11",
	"plugins": [
		".",
		"https://downloads.wordpress.org/plugin/plugin-check.2.1.0.zip"
	],
	"port": 8888,
	"mappings": {
		"wp-content/mu-plugins": "./dev/mu-plugins"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"WP_DEFAULT_THEME": "twentytwentyfive",
		"FORMSTEAD_MAILPIT_HOST": "formstead-mailpit"
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp theme activate twentytwentyfive"
	},
	"env": {
		"tests": {
			"config": {
				"FORMSTEAD_E2E": true,
				"FORMSTEAD_E2E_FAULTS": true
			}
		}
	}
}
