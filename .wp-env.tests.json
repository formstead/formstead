{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#7.1.3",
	"phpVersion": "8.3",
	"mariadbVersion": "10.11",
	"plugins": [
		".",
		"https://downloads.wordpress.org/plugin/plugin-check.2.1.0.zip"
	],
	"port": 8889,
	"mappings": {
		"wp-content/mu-plugins": "./dev/mu-plugins"
	},
	"config": {
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEBUG": false,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"FORMSTEAD_MAILPIT_HOST": "formstead-mailpit",
		"FORMSTEAD_E2E": true,
		"FORMSTEAD_E2E_FAULTS": true,
		"SCRIPT_DEBUG": false
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli --config=.wp-env.tests.json wp theme activate twentytwentyfive"
	},
	"testsEnvironment": false
}
