---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<style>
			body {
				font-family: system-ui, sans-serif;
				line-height: 1.5;
				margin: 2rem;
			}

			form {
				max-width: 32rem;
			}

			label {
				font-weight: 600;
			}

			input,
			textarea {
				box-sizing: border-box;
				display: block;
				margin: 0.25rem 0 0.25rem;
				width: 100%;
			}

			button {
				margin-top: 1rem;
			}

			.formstead-honeypot {
				position: absolute;
				left: -10000px;
				height: 1px;
				width: 1px;
				overflow: hidden;
			}

			[role='status'] {
				margin-top: 1rem;
			}
		</style>
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>
