# Submissions URL from the form screen. The server route posts here and does not send Origin.
FORMSTEAD_ENDPOINT=http://localhost:8889/wp-json/formstead/v1/forms/fs_example/submissions

# Optional. When all three are set, the webhook route reads the submission after the signature checks.
FORMSTEAD_API_BASE=http://localhost:8889/wp-json/formstead/v1
FORMSTEAD_API_USER=
FORMSTEAD_API_PASSWORD=

# whsec_ secret from the form screen.
FORMSTEAD_WEBHOOK_SECRET=
